{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/agent.schema.json",
  "title": "Agent configuration",
  "description": "Schema enforcing OWASP Agentic AI (ASI) preconditions on agent configs.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "agentic/v1" },
    "kind": { "const": "Agent" },
    "metadata": {
      "type": "object",
      "required": ["name", "owner", "environment", "killSwitch"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["dev", "staging", "prod"] },
        "killSwitch": {
          "type": "string",
          "minLength": 1,
          "description": "ASI10: named revocation target so the agent can be disabled."
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["model", "inputs", "tools", "autonomy", "memory", "observability"],
      "properties": {
        "description": { "type": "string" },
        "model": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "description": "ASI01: every input must declare a trust level.",
          "items": {
            "type": "object",
            "required": ["name", "trust"],
            "properties": {
              "name": { "type": "string" },
              "trust": { "enum": ["trusted", "untrusted"] }
            },
            "additionalProperties": false
          }
        },
        "tools": {
          "type": "array",
          "description": "ASI02: tools the agent may call (names resolved in ToolManifest).",
          "items": { "type": "string" }
        },
        "autonomy": {
          "type": "object",
          "required": [
            "maxToolCallsPerRun",
            "allowCodeExecution",
            "highImpactActions",
            "requiresHumanApproval"
          ],
          "properties": {
            "maxToolCallsPerRun": { "type": "integer", "minimum": 1, "maximum": 100 },
            "allowCodeExecution": { "type": "boolean" },
            "highImpactActions": {
              "type": "array",
              "description": "ASI09: each high-impact action must require approval (checked by OPA).",
              "items": {
                "type": "object",
                "required": ["name", "requiresApproval"],
                "properties": {
                  "name": { "type": "string" },
                  "requiresApproval": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "requiresHumanApproval": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "memory": {
          "type": "object",
          "required": ["persistence", "sanitizeInputs"],
          "properties": {
            "persistence": { "enum": ["none", "session", "long-term"] },
            "sanitizeInputs": {
              "type": "boolean",
              "description": "ASI06: inputs into memory must be sanitized."
            },
            "ragSources": {
              "type": "array",
              "items": { "type": "string", "format": "uri" }
            }
          },
          "additionalProperties": false
        },
        "interAgent": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "requireMutualTls": { "type": "boolean" },
            "requireMessageAuth": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "observability": {
          "type": "object",
          "required": ["auditLog", "logToolCalls"],
          "properties": {
            "auditLog": { "const": true },
            "logToolCalls": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
