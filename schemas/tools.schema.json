{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/tools.schema.json",
  "title": "Tool manifest",
  "description": "Schema enforcing ASI02 (least agency) and ASI04 (pinned supply chain) on tools.",
  "type": "object",
  "required": ["apiVersion", "kind", "tools"],
  "properties": {
    "apiVersion": { "const": "agentic/v1" },
    "kind": { "const": "ToolManifest" },
    "metadata": {
      "type": "object",
      "properties": { "owner": { "type": "string" } }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "scopes", "mutating", "requiresApproval", "source"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "description": "ASI02: least-privilege scopes; must be explicit and non-empty.",
            "items": { "type": "string", "pattern": "^[a-z_]+:[a-z_]+$" }
          },
          "mutating": { "type": "boolean" },
          "requiresApproval": { "type": "boolean" },
          "source": {
            "type": "object",
            "required": ["registry", "package", "version", "integrity"],
            "description": "ASI04: pin source + integrity so tools can't be swapped at runtime.",
            "properties": {
              "registry": { "type": "string", "minLength": 1 },
              "package": { "type": "string", "minLength": 1 },
              "version": {
                "type": "string",
                "description": "Pinned semver; 'latest'/ranges rejected.",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "integrity": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
